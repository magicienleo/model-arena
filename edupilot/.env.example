# Secrets et configuration locale uniquement — aucun service externe.
# Copier vers .env.local (ou exporter ces variables dans l'hébergeur mutualisé).

# Secret de signature des sessions JWT NextAuth (à remplacer en production)
AUTH_SECRET=changez-moi-avec-une-chaine-aleatoire-d-au-moins-32-caracteres

# Mot de passe des comptes de démonstration créés par le seed (défaut : edupilot)
SEED_PASSWORD=edupilot

# Port d'écoute du processus Node unique
PORT=3000

# Adresse publique (facultatif derrière un reverse-proxy mutualisé)
# AUTH_URL=https://edupilot.exemple.fr

# Chemins des données locales : voir src/lib/env.ts
# data/edupilot.db   → base SQLite unique
# uploads/           → pièces justificatives et photos HACCP
